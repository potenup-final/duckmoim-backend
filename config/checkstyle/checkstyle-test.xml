<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  테스트 코드 규칙. 프로덕션 설정과 다른 점은 메서드 네이밍 하나다.

  테스트 컨벤션이 실패 케이스를 {메서드명}_{실패이유} 형식으로 쓰게 정했다.
    pay()                   성공
    pay_pointIsNotEnough()  실패

  프로덕션 설정을 그대로 쓰면 이 형식이 전부 위반으로 잡힌다. 그래서 나눴다.
  @DisplayName 누락은 정규식으로 판정할 수 없어 ArchUnit 이 본다.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="RegexpSingleline">
    <property name="format" value="//\s*(FIXME|XXX|HACK)"/>
    <property name="message"
              value="마커는 TODO 하나만 씁니다 (코드 컨벤션 · TODO 태그)"/>
  </module>

  <module name="TreeWalker">
    <!-- 성공 케이스는 camelCase, 실패 케이스는 밑줄 하나까지 허용한다 -->
    <module name="MethodName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)?$"/>
      <message key="name.invalidPattern"
               value="테스트 메서드명은 pay 또는 pay_pointIsNotEnough 형식입니다 (테스트 컨벤션 · 네이밍 규칙)"/>
    </module>

    <module name="TypeName"/>
    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
  </module>
</module>

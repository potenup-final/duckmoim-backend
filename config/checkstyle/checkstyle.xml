<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  프로덕션 코드 규칙. 위키 04-협업-규칙/코드-컨벤션.md 에서 기계가 판정할 수 있는
  항목만 옮겼다. "service 가 비즈니스 흐름으로 읽히는가" 같은 항목은 옮길 수 없고
  사람 리뷰에 남는다.

  포맷은 Spotless(googleJavaFormat)가 본다. 여기에 포맷 규칙을 넣으면 두 도구가
  서로 다른 답을 내서 고칠 수 없는 상태가 된다.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!--
    로그 위치 prefix. 코드 컨벤션이 [클래스명.메서드명] 형식을 요구한다.
    prefix 만 보고 코드 위치를 검색할 수 있어야 한다는 것이 근거다.
  -->
  <module name="RegexpSingleline">
    <property name="format" value="log\.(trace|debug|info|warn|error)\(\s*&quot;(?!\[[A-Z][A-Za-z0-9]*\.[a-z][A-Za-z0-9]*\])"/>
    <property name="message"
              value="로그 메시지는 [클래스명.메서드명] prefix 로 시작해야 합니다 (코드 컨벤션 · 로그 위치 Prefix 규칙)"/>
  </module>

  <!--
    로그 메시지에 문자열 더하기 금지. placeholder 를 쓴다.
    불필요한 문자열 생성을 줄이고 구조화 로그로 전환하기 쉽게 하려는 것이다.
  -->
  <module name="RegexpSingleline">
    <property name="format" value="log\.(trace|debug|info|warn|error)\([^)]*&quot;\s*\+"/>
    <property name="message"
              value="로그에 문자열 더하기를 쓰지 않습니다. placeholder '{}' 를 쓰세요 (코드 컨벤션 · 로깅 규칙)"/>
  </module>

  <!--
    마커는 TODO 하나만 쓴다. 운영하면서 구분이 필요해지면 그때 논의해 추가한다.
  -->
  <module name="RegexpSingleline">
    <property name="format" value="//\s*(FIXME|XXX|HACK)"/>
    <property name="message"
              value="마커는 TODO 하나만 씁니다. 해소 조건을 함께 적으세요 (코드 컨벤션 · TODO 태그)"/>
  </module>

  <module name="TreeWalker">
    <!-- 메서드명은 동사로 시작하는 camelCase. 프로덕션에는 밑줄을 쓰지 않는다 -->
    <module name="MethodName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </module>

    <module name="TypeName"/>
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>

    <!--
      import 규칙. 무엇이 쓰이는지 읽히지 않으면 레이어 위반도 눈에 안 띈다.
      ArchUnit 이 잡는 것과 별개로, 와일드카드는 그 판독 자체를 막는다.
    -->
    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>

    <!-- 중첩 if 가 깊어지면 early return · 정책 객체 · validator 분리를 검토한다 -->
    <module name="NestedIfDepth">
      <property name="max" value="2"/>
    </module>

    <!-- equals/hashCode 는 함께 정의한다 -->
    <module name="EqualsHashCode"/>

    <!-- 한 줄에 선언 하나. 값 객체의 필드가 뭉쳐 있으면 불변성 검토가 어려워진다 -->
    <module name="MultipleVariableDeclarations"/>

    <!-- switch 에 default 를 요구한다. enum 이 늘었을 때 조용히 빠지는 분기를 막는다 -->
    <module name="MissingSwitchDefault"/>
  </module>
</module>

# 로컬 DB 접속 정보. `.env` 로 복사해서 쓴다. `.env` 는 커밋되지 않는다 (.gitignore).
#
#   cp .env.example .env
#
# docker compose 는 같은 디렉터리의 `.env` 를 자동으로 읽는다.
# 애플리케이션(application-local.yml)은 환경변수를 읽으므로, 값을 바꿨으면
# 셸에도 함께 넣어야 한다. 기본값을 그대로 쓸 거면 `.env` 없이도 동작한다.
# 호스트 포트. 컨테이너 안쪽 3306 과 다르다 (docker-compose.yml 주석 참고).
DB_PORT=3307
DB_NAME=duckmoim
DB_USERNAME=duckmoim
DB_PASSWORD=duckmoim

# 컨테이너 초기화에만 쓰인다. 애플리케이션은 root 로 접속하지 않는다.
DB_ROOT_PASSWORD=root
